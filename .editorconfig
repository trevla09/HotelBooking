root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml}]
indent_size = 2

[*.cs]
max_line_length = 100


csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_prefer_braces = true:warning
csharp_indent_case_contents = true
dotnet_sort_system_directives_first = true


csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion


dotnet_naming_rule.priv_underscore.symbols = priv_field
# іменування: константи — PascalCase без підкреслення (перевіряється раніше за правило полів)
dotnet_naming_rule.const_pascal.symbols = const_field
dotnet_naming_rule.const_pascal.style = pascal_case_style
dotnet_naming_rule.const_pascal.severity = warning
dotnet_naming_symbols.const_field.applicable_kinds = field
dotnet_naming_symbols.const_field.applicable_accessibilities = *
dotnet_naming_symbols.const_field.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_rule.priv_underscore.style = underscore_camel
dotnet_naming_rule.priv_underscore.severity = warning
dotnet_naming_symbols.priv_field.applicable_kinds = field
dotnet_naming_symbols.priv_field.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# StyleCop: свідомо вимкнені правила
# заголовок з ліцензією в навчальному проєкті не потрібен
dotnet_diagnostic.SA1633.severity = none
# префікс this. суперечить конвенції .NET
dotnet_diagnostic.SA1101.severity = none
# using поза namespace — стандарт шаблонів .NET
dotnet_diagnostic.SA1200.severity = none
# приватні поля іменуємо з _, як прийнято в .NET
dotnet_diagnostic.SA1309.severity = none
# документація українською, а правила вимагають англійських шаблонів
# "Gets ..." для властивостей і "Initializes a new instance ..." для конструкторів
dotnet_diagnostic.SA1623.severity = none
dotnet_diagnostic.SA1642.severity = none
# у консольному застосунку XML-документацію не генеруємо, тому SA0001 вимкнено
dotnet_diagnostic.SA0001.severity = none
# з ЛР № 2 документація обов'язкова (GenerateDocumentationFile у Core)
dotnet_diagnostic.SA1600.severity = warning
dotnet_diagnostic.SA1601.severity = warning
dotnet_diagnostic.SA1602.severity = warning
# кома в кінці багаторядкового ініціалізатора необов'язкова
dotnet_diagnostic.SA1413.severity = none

# правила, які лишаємо суворими
dotnet_diagnostic.SA1028.severity = warning
dotnet_diagnostic.SA1201.severity = warning
dotnet_diagnostic.SA1503.severity = warning
dotnet_diagnostic.SA1507.severity = warning
dotnet_diagnostic.SA1516.severity = warning
dotnet_diagnostic.IDE0055.severity = warning